<?xml version="1.0" encoding="utf-8"?>
<Mod id="unlock_all_mementos_continued" version="1"
	xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_UAMC_NAME</Name>
		<Description>LOC_MODULE_UAMC_DESCRIPTION</Description>
		<Authors>Alkeari</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="unlock-all-mementos-continued" scope="shell" criteria="always" loadOrder="-1">
			<Actions>
				<UIScripts>
					<Item>ui/shell/create-panels/unlock-all-mementos-continued.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
		<ActionGroup id="loader" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>loader.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>localization.xml</File>
	</LocalizedText>
</Mod>